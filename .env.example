# Copy this file to .env and fill in real values (from Supabase → Settings → API).
# .env is gitignored — never commit real credentials.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The email of the single Supabase Auth user you create for yourself
# (Supabase dashboard → Authentication → Users → Add User). Not a secret —
# only the password you set for that user matters. The login screen shows
# just a password field; this email is used behind the scenes.
VITE_AUTH_EMAIL=
